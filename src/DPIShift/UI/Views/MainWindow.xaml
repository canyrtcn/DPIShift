<Window x:Class="DPIShift.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DPIShift — Uygulama Bazlı Ekran Ölçeklendirme"
        Width="1120"
        Height="785"
        MinWidth="940"
        MinHeight="620"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRootBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/DPIShift;component/Assets/dpishift.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Outer 1px border frame unifying the custom chrome -->
    <Border BorderBrush="#2A2A30" BorderThickness="1" Background="{StaticResource BgRootBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- UNIFIED TITLEBAR & APPLICATION HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgChromeBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Identity (Draggable part of titlebar) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/DPIShift;component/Assets/dpishift.ico"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0" />
                        <TextBlock Text="DPIShift"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="·"
                                   FontSize="13"
                                   Foreground="#484852"
                                   Margin="8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Uygulama Bazlı DPI Ölçeklendirme"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Telemetry Readouts + Settings Trigger -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <!-- Windows Global Scale Readout -->
                        <Border Background="#1D1D21"
                                BorderBrush="#2C2C33"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="9,4"
                                Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5.5" Height="5.5" Fill="#5ED194" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SystemScaleBadgeText}"
                                           FontSize="11.5"
                                           Foreground="#C4C4CC" />
                            </StackPanel>
                        </Border>

                        <!-- Active Rules Readout -->
                        <Border Background="{StaticResource AccentSoftBgBrush}"
                                BorderBrush="{StaticResource AccentSoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="9,4"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding ActiveRulesBadgeText}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F08A5D" />
                        </Border>

                        <!-- Settings Button (Hit-testable inside WindowChrome) -->
                        <Button Command="{Binding ToggleSettingsCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="28"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6,1 L 7.2,1 L 7.5,2.4 C 7.9,2.55 8.3,2.78 8.65,3.05 L 10,2.6 L 10.85,4.1 L 9.8,5.05 C 9.88,5.35 9.88,5.65 9.8,5.95 L 10.85,6.9 L 10,8.4 L 8.65,7.95 C 8.3,8.22 7.9,8.45 7.5,8.6 L 7.2,10 L 6,10 L 5.7,8.6 C 5.3,8.45 4.9,8.22 4.55,7.95 L 3.2,8.4 L 2.35,6.9 L 3.4,5.95 C 3.32,5.65 3.32,5.35 3.4,5.05 L 2.35,4.1 L 3.2,2.6 L 4.55,3.05 C 4.9,2.78 5.3,2.55 5.7,2.4 Z M 6.6,4.1 A 1.4,1.4 0 1 0 6.6,6.9 A 1.4,1.4 0 1 0 6.6,4.1 Z"
                                      Stroke="#C8C8D0"
                                      StrokeThickness="1.15"
                                      Width="13"
                                      Height="11"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Ayarlar" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Native-Integrated Window Caption Controls (Minimize / Maximize / Close) -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="1" Background="#242429" Margin="0,11,0,11" />

                        <Button Click="MinimizeWindow_Click"
                                ToolTip="Küçült"
                                Style="{StaticResource WindowCaptionButtonStyle}">
                            <Path Data="M 0,5 L 10,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Width="10"
                                  Height="10" />
                        </Button>

                        <Button Click="MaximizeRestoreWindow_Click"
                                ToolTip="Ekranı Kapla / Geri Yükle"
                                Style="{StaticResource WindowCaptionButtonStyle}">
                            <Grid Width="10" Height="10">
                                <!-- Single square when Normal -->
                                <Path x:Name="MaximizeGlyph"
                                      Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" />
                                <!-- Overlapping squares when Maximized -->
                                <Path x:Name="RestoreGlyph"
                                      Visibility="Collapsed"
                                      Data="M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 L 7.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" />
                            </Grid>
                        </Button>

                        <Button Click="CloseWindow_Click"
                                ToolTip="Kapat"
                                Style="{StaticResource WindowCloseButtonStyle}">
                            <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  Width="10"
                                  Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="386" MinWidth="330" MaxWidth="470" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: APPLICATION PICKER -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="14,14,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Input + .exe Browse + Refresh -->
                        <Grid Grid.Row="0" Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="28,7,10,7"
                                         Style="{StaticResource ModernTextBoxStyle}" />
                                <!-- Crisp Vector Search Icon -->
                                <Path Data="M 4.5,0.8 A 3.7,3.7 0 1 0 4.5,8.2 A 3.7,3.7 0 1 0 4.5,0.8 Z M 7.3,7.3 L 10.2,10.2"
                                      Stroke="#686873"
                                      StrokeThickness="1.3"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="10,0,0,0"
                                      IsHitTestVisible="False" />
                                <TextBlock Text="Uygulama ara..."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12.5"
                                           Margin="30,0,8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="1"
                                    ToolTip="Diskten çalıştırılabilir (.exe) uygulama seçin"
                                    Command="{Binding BrowseExecutableCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1,2.5 L 4.5,2.5 L 5.8,4 L 11,4 L 11,9.5 L 1,9.5 Z"
                                          Stroke="#C4C4CE"
                                          StrokeThickness="1.2"
                                          Width="12"
                                          Height="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text=".exe Seç" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    ToolTip="Uygulama ve çalışan pencere listesini yenile"
                                    Command="{Binding RefreshAppsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="33"
                                    Padding="0"
                                    Margin="5,0,0,0">
                                <Path Data="M 9.8,3.2 A 4.2,4.2 0 1 0 10.3,6.4 M 10.2,1.0 L 10.2,3.5 L 7.7,3.5"
                                      Stroke="#C4C4CE"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- Recessed Segmented Filter Control (Tümü / Çalışan / Özel) -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BgRecessedBrush}"
                                BorderBrush="#25252B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3"
                                Margin="0,0,4,10">
                            <UniformGrid Columns="3">
                                <Button Command="{Binding SetFilterTabCommand}"
                                        CommandParameter="All">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTabAll}" Value="True">
                                                    <Setter Property="Background" Value="#27272E" />
                                                    <Setter Property="BorderBrush" Value="#383842" />
                                                    <Setter Property="Foreground" Value="#F2F2F4" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <Run Text="Tümü (" /><Run Text="{Binding TotalAppsCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Button>

                                <Button Command="{Binding SetFilterTabCommand}"
                                        CommandParameter="Running">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTabRunning}" Value="True">
                                                    <Setter Property="Background" Value="#27272E" />
                                                    <Setter Property="BorderBrush" Value="#383842" />
                                                    <Setter Property="Foreground" Value="#F2F2F4" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <Run Text="Çalışan (" /><Run Text="{Binding RunningAppsCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Button>

                                <Button Command="{Binding SetFilterTabCommand}"
                                        CommandParameter="Configured">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTabConfigured}" Value="True">
                                                    <Setter Property="Background" Value="#27272E" />
                                                    <Setter Property="BorderBrush" Value="#383842" />
                                                    <Setter Property="Foreground" Value="#F2F2F4" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <Run Text="Özel (" /><Run Text="{Binding ConfiguredAppsCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- Supported Only Switch -->
                        <Border Grid.Row="2" Margin="2,0,6,9">
                            <CheckBox Content="Yalnızca ölçeklenebilir uygulamaları göster"
                                      IsChecked="{Binding ShowSupportedOnly}"
                                      Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12" />
                        </Border>

                        <!-- Virtualized Application List -->
                        <Grid Grid.Row="3">
                            <ListBox ItemsSource="{Binding FilteredApps}"
                                     SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource AppListItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Recessed App Icon Well -->
                                            <Border Width="31"
                                                    Height="31"
                                                    CornerRadius="6"
                                                    Background="#1A1A1E"
                                                    BorderBrush="#2A2A31"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <Image Source="{Binding Icon}"
                                                       Width="21"
                                                       Height="21"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>

                                            <!-- App Name & Framework Line -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12.8"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="188" />
                                                    <Ellipse Width="5.5"
                                                             Height="5.5"
                                                             Fill="#5ED194"
                                                             Margin="6,1,0,0"
                                                             VerticalAlignment="Center"
                                                             ToolTip="Şu anda çalışıyor"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,1.5,0,0">
                                                    <TextBlock Text="{Binding TechnologyBadge}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text=" · "
                                                               FontSize="11"
                                                               Foreground="#474750" />
                                                    <TextBlock Text="{Binding SupportBadgeText}"
                                                               FontSize="11"
                                                               Foreground="{Binding Support, Converter={StaticResource SupportFgConverter}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Active Scale Monospace Tag -->
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource AccentSoftBgBrush}"
                                                    BorderBrush="{StaticResource AccentSoftBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasCustomScale, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ConfiguredScaleBadge}"
                                                           FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F08A5D" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Loading Overlay -->
                            <Border Background="#CC151517"
                                    CornerRadius="6"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Uygulamalar analiz ediliyor..."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT WORKSPACE: SELECTED APP INSPECTOR & SCALING CONTROLS -->
                <Grid Grid.Column="1" Background="{StaticResource BgRootBrush}">
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedApp, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Sol listeden bir uygulama seçin veya '.exe Seç' ile ekleyin"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13.5"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Detail Cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="22,16,22,14"
                                  Visibility="{Binding HasSelectedApp, Converter={StaticResource BoolToVis}}">
                        <StackPanel MaxWidth="760">

                            <!-- 1. APP IDENTITY HEADER CARD -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderCardBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,13"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="8"
                                            Background="#161619"
                                            BorderBrush="#2C2C33"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding SelectedApp.Icon}"
                                               Width="30"
                                               Height="30"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedApp.DisplayName}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="410" />
                                            <Border CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="#18181C"
                                                    BorderBrush="#2D2D35"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5.5"
                                                             Height="5.5"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#63636E" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedApp.IsRunning}" Value="True">
                                                                        <Setter Property="Fill" Value="#5ED194" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding SelectedApp.RunningStateText}"
                                                               FontSize="11"
                                                               Foreground="#B8B8C2" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SelectedApp.ExecutablePath}"
                                                   FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedApp.ExecutablePath}"
                                                   Margin="0,4,0,7" />

                                        <WrapPanel>
                                            <Border Background="#18181B"
                                                    BorderBrush="#2A2A31"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2.5"
                                                    Margin="0,0,6,0">
                                                <TextBlock FontSize="11.5" Foreground="#CECED6">
                                                    <Run Text="Altyapı: " Foreground="#72727D" /><Run Text="{Binding SelectedApp.TechnologyBadge, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>

                                            <Border Background="#18181B"
                                                    BorderBrush="#2A2A31"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2.5">
                                                <TextBlock FontSize="11.5" Foreground="#CECED6">
                                                    <Run Text="DPI Modu: " Foreground="#72727D" /><Run Text="{Binding SelectedApp.DpiAwarenessLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding OpenExecutableFolderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Top"
                                            MinHeight="30"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1,2 L 4.5,2 L 5.7,3.5 L 11,3.5 L 11,9.5 L 1,9.5 Z"
                                                  Stroke="#B8B8C2"
                                                  StrokeThickness="1.15"
                                                  Width="11"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                                            <TextBlock Text="Konumu Aç" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 2. COMPATIBILITY REPORT CARD -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderCardBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,10"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3.5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Semantic Vertical Indicator Strip -->
                                    <Border Grid.Column="0"
                                            Background="{Binding SelectedApp.Support, Converter={StaticResource SupportFgConverter}}" />

                                    <StackPanel Grid.Column="1" Margin="15,12,16,12">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{Binding SelectedApp.Support, Converter={StaticResource SupportBgConverter}}"
                                                    BorderBrush="{Binding SelectedApp.Support, Converter={StaticResource SupportBorderConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedApp.SupportBadgeText}"
                                                           Foreground="{Binding SelectedApp.Support, Converter={StaticResource SupportFgConverter}}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedApp.Compatibility.SummaryTitle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>

                                        <TextBlock Text="{Binding SelectedApp.Compatibility.Explanation}"
                                                   Foreground="#B4B4BE"
                                                   FontSize="12.3"
                                                   LineHeight="18.5"
                                                   TextWrapping="Wrap" />

                                        <Border Background="#19191D"
                                                BorderBrush="#292930"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,6"
                                                Margin="0,9,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedApp.Compatibility.MechanismDescription}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedApp.Compatibility.MechanismDescription}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11.3"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. PRECISION SCALE CALIBRATION CARD -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderCardBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18,15"
                                    IsEnabled="{Binding SelectedApp.CanScale}"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedApp.CanScale}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- Section Title + Tabular Numeric Input -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Arayüz / DPI Ölçek Oranı"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ScaleComparisonText}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Recessed Precision % Readout Input -->
                                        <Border Grid.Column="1"
                                                Background="#121215"
                                                BorderBrush="#2E2E36"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="%"
                                                           FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,2,0" />
                                                <TextBox Text="{Binding DraftScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="54"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         CaretBrush="{StaticResource AccentBrush}"
                                                         FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                         TextAlignment="Right"
                                                         FontSize="16"
                                                         FontWeight="Bold"
                                                         Padding="2,4" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Custom Precision Slider + Calibration Scale Ticks -->
                                    <Slider Minimum="75"
                                            Maximum="225"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="False"
                                            SmallChange="5"
                                            LargeChange="25"
                                            Value="{Binding DraftScalePercent, Mode=TwoWay}"
                                            Style="{StaticResource PrecisionSliderStyle}"
                                            Cursor="Hand" />

                                    <Grid Margin="2,2,2,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="%75" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                        <TextBlock Grid.Column="1" Text="%100" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#888894" />
                                        <TextBlock Grid.Column="2" Text="%125" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                        <TextBlock Grid.Column="3" Text="%150" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                        <TextBlock Grid.Column="4" Text="%175" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                        <TextBlock Grid.Column="5" Text="%200" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                        <TextBlock Grid.Column="6" Text="%225" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#5E5E68" />
                                    </Grid>

                                    <!-- Preset Scale Chips -->
                                    <TextBlock Text="HIZLI ÖLÇEK SEÇİMİ"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,7" />

                                    <ItemsControl ItemsSource="{Binding PresetScales}" Margin="0,0,0,9">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.SelectPresetScaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PresetChipButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource ValuesEqualConverter}">
                                                                            <Binding Path="." />
                                                                            <Binding Path="DataContext.DraftScalePercent" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="#2A201C" />
                                                                    <Setter Property="BorderBrush" Value="#E5703E" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Recessed Ratio Bar -->
                                    <Border Background="#161619"
                                            BorderBrush="#28282F"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="13,8"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="Ölçek Karşılaştırması"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="Gerçek Vektörel Çizim"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C8C8D2"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Width="115"
                                                        Height="5"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="2.5"
                                                        Background="#383842"
                                                        ToolTip="Baz %100 Referans Boyutu"
                                                        Margin="0,0,0,5" />
                                                <Border Width="{Binding PreviewBarWidth}"
                                                        Height="7"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="3.5"
                                                        Background="{StaticResource AccentBrush}"
                                                        ToolTip="Hedef Uygulama Ölçeği" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Contextual Integration Switches -->
                                    <StackPanel>
                                        <CheckBox Content="Masaüstü, Başlat Menüsü ve Görev Çubuğu kısayollarını otomatik güncelle (Yedeklenir)"
                                                  IsChecked="{Binding DraftUpdateShortcuts}"
                                                  Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                                  Margin="0,0,0,8"
                                                  Visibility="{Binding ShowShortcutIntegrationOption, Converter={StaticResource BoolToVis}}" />

                                        <CheckBox Content="Uygulama penceresi açıldığında arka planda otomatik olarak bu DPI ölçeğini uygula"
                                                  IsChecked="{Binding DraftAutoApplyOnOpen}"
                                                  Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                                  Margin="0,0,0,4"
                                                  Visibility="{Binding ShowAutoRuntimeOption, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. PRIMARY ACTION BAR -->
                            <WrapPanel Margin="0,2,0,8">
                                <!-- Save & Apply -->
                                <Button Command="{Binding ApplyScaleCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,9,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1,5.5 L 4.2,8.7 L 10.5,2"
                                              Stroke="#141416"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11"
                                              Height="10"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding PrimaryApplyButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Restart & Apply -->
                                <Button Command="{Binding ApplyAndRestartCommand}"
                                        Style="{StaticResource SignalButtonStyle}"
                                        Margin="0,0,9,8"
                                        Visibility="{Binding ShowRestartAndApplyButton, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 9.8,3.2 A 4.2,4.2 0 1 0 10.3,6.4 M 10.2,1.0 L 10.2,3.5 L 7.7,3.5"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0" />
                                        <TextBlock Text="Uygula ve Şimdi Yeniden Başlat" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Launch Scaled -->
                                <Button Command="{Binding LaunchScaledCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,9,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5,1 L 9.5,5.5 L 1.5,10 Z"
                                              Fill="#D8D8E0"
                                              Width="9"
                                              Height="10"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0" />
                                        <TextBlock Text="Ölçekli Başlat" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Create Desktop Shortcut -->
                                <Button Command="{Binding CreateDesktopShortcutCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,9,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 6,1.5 L 10.5,1.5 L 10.5,6 M 10.2,1.8 L 4.5,7.5 M 8.5,6.8 L 8.5,10 L 1.5,10 L 1.5,3 L 4.7,3"
                                              Stroke="#C8C8D2"
                                              StrokeThickness="1.25"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0" />
                                        <TextBlock Text="Masaüstü Kısayolu" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Reset to 100% -->
                                <Button Command="{Binding ResetScaleCommand}"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 3.2,2.5 L 1,4.7 L 3.2,6.9 M 1.3,4.7 L 7.2,4.7 A 3.2,3.2 0 1 1 7.2,11.1 L 4.5,11.1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0" />
                                        <TextBlock Text="Varsayılana Döndür (%100)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS DRAWER OVERLAY -->
                    <Grid Background="#B80C0C0E"
                          Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                        <Border Width="430"
                                HorizontalAlignment="Right"
                                Background="#18181B"
                                BorderBrush="#2E2E36"
                                BorderThickness="1,0,0,0"
                                Padding="22,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <TextBlock Text="Uygulama ve Sistem Tepsisi"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding ToggleSettingsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            MinHeight="28"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                                                  Stroke="#C8C8D2"
                                                  StrokeThickness="1.2"
                                                  Width="8"
                                                  Height="8"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                                            <TextBlock Text="Kapat" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="SİSTEM TEPSİSİ (SYSTEM TRAY)"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,10" />

                                    <CheckBox Content="Pencere kapatıldığında (X) sistem tepsisine küçült"
                                              IsChecked="{Binding CloseToTray}"
                                              Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                              Margin="0,0,0,12" />

                                    <CheckBox Content="Simge durumuna küçültüldüğünde (—) tepsiye gizle"
                                              IsChecked="{Binding MinimizeToTray}"
                                              Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                              Margin="0,0,0,12" />

                                    <CheckBox Content="Windows açılışında sistem tepsisinde otomatik başlat"
                                              IsChecked="{Binding StartWithWindows}"
                                              Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                              Margin="0,0,0,20" />

                                    <Border Height="1" Background="#27272E" Margin="0,0,0,16" />

                                    <TextBlock Text="PERFORMANS VE ARKA PLAN İZLEYİCİ"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,10" />

                                    <CheckBox Content="Canlı pencere DPI izleyicisini etkin tut (%0 boşta CPU)"
                                              IsChecked="{Binding EnableBackgroundRuntimeScaling}"
                                              Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                                              Margin="0,0,0,8" />

                                    <TextBlock Text="Sürekli döngü (polling) veya DLL enjeksiyonu kullanılmaz. Oyun performansını ve hile koruma sistemlerini etkilemez; etkin canlı kural yoksa kanca devre dışı kalır."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,20" />

                                    <Border Height="1" Background="#27272E" Margin="0,0,0,16" />

                                    <TextBlock Text="KURALLARI SIFIRLAMA"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,10" />

                                    <Button Content="Tüm Uygulama Ölçeklerini Sıfırla ve Varsayılana Döndür"
                                            Command="{Binding ResetAllRulesCommand}"
                                            Style="{StaticResource DangerOutlineButtonStyle}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <Border Height="1" Background="#27272E" Margin="0,0,0,12" />
                                    <Button Content="DPIShift'i Tamamen Kapat (Tepsiden Çık)"
                                            Click="CompletelyExit_Click"
                                            Style="{StaticResource DangerOutlineButtonStyle}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- BOTTOM STATUS BAR -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgChromeBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="6"
                             Height="6"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#5ED194" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusWarning}" Value="True">
                                        <Setter Property="Fill" Value="#EAB34E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="11.8"
                               Foreground="#BEBEC8"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="2"
                               Text="%LOCALAPPDATA%\DPIShift"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
